<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Blobby the Jelly</title>
<style>
:root{--sky1:#ffd1f0;--sky2:#a8e6ff;--ink:#4a2a5c;--bubble:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--sky1:#3a1f5c;--sky2:#14274e;--ink:#ffe3f6;--bubble:#2b1d45}}
:root[data-theme="dark"]{--sky1:#3a1f5c;--sky2:#14274e;--ink:#ffe3f6;--bubble:#2b1d45}
html,body{height:100%;margin:0;overflow:hidden}
body{background:linear-gradient(180deg,var(--sky1),var(--sky2));font-family:"Comic Sans MS","Chalkboard SE",system-ui,sans-serif;color:var(--ink);touch-action:manipulation;user-select:none}
canvas{display:block;position:fixed;inset:0}
#hint{position:fixed;left:0;right:0;bottom:calc(18px + env(safe-area-inset-bottom,0px));text-align:center;font-size:18px;opacity:.85;pointer-events:none}
#title{position:fixed;left:0;right:0;top:calc(14px + env(safe-area-inset-top,0px));text-align:center;font-size:26px;font-weight:bold;pointer-events:none}
#bubble{position:fixed;left:0;top:0;transform:translate(-50%,-100%);background:var(--bubble);color:var(--ink);padding:8px 14px;border-radius:18px;font-size:18px;white-space:nowrap;box-shadow:0 4px 14px rgba(0,0,0,.2);opacity:0;transition:opacity .2s;pointer-events:none}
#bubble::after{content:"";position:absolute;left:50%;bottom:-8px;margin-left:-8px;border:8px solid transparent;border-bottom:0;border-top-color:var(--bubble)}
</style>
</head>
<body>
<div id="title">Blobby the Jelly 🍮</div>
<div id="bubble"></div>
<div id="hint">Poke Blobby! Move your mouse and watch his eyes 👀</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const renderer = new THREE.WebGLRenderer({antialias:true, alpha:true});
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
document.body.appendChild(renderer.domElement);
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
camera.position.set(0, 2.8, 8.5);
camera.lookAt(0, 1.7, 0);
function resize(){
  renderer.setSize(innerWidth, innerHeight);
  camera.aspect = innerWidth / innerHeight;
  camera.position.z = innerWidth < innerHeight ? 12 : 8.5;
  camera.updateProjectionMatrix();
}
addEventListener('resize', resize); resize();

scene.add(new THREE.HemisphereLight(0xffffff, 0xffb3e6, 0.9));
const sun = new THREE.DirectionalLight(0xffffff, 0.8);
sun.position.set(3, 6, 5); scene.add(sun);

const M = (c, r=0.4) => new THREE.MeshStandardMaterial({color:c, roughness:r});
const ground = new THREE.Mesh(new THREE.CircleGeometry(4.5, 48), M(0xb8f5c8, 0.9));
ground.rotation.x = -Math.PI/2; scene.add(ground);
const shadow = new THREE.Mesh(new THREE.CircleGeometry(1, 32),
  new THREE.MeshBasicMaterial({color:0x000000, transparent:true, opacity:0.25}));
shadow.rotation.x = -Math.PI/2; shadow.position.y = 0.02; scene.add(shadow);

// ---- Blobby ----
const blobRoot = new THREE.Group(); scene.add(blobRoot);   // jumps
const blob = new THREE.Group(); blobRoot.add(blob);        // squashes from the base
const body = new THREE.Mesh(new THREE.SphereGeometry(1, 48, 32), M(0xff7eb6, 0.3));
body.position.y = 1; blob.add(body);

const eyes = new THREE.Group(); eyes.position.y = 1.4; blob.add(eyes);
const pupils = [];
[-1, 1].forEach(s => {
  const e = new THREE.Mesh(new THREE.SphereGeometry(0.28, 24, 16), M(0xffffff, 0.2));
  e.position.set(s*0.36, 0, 0.78); eyes.add(e);
  const p = new THREE.Mesh(new THREE.SphereGeometry(0.12, 16, 12), M(0x1b1030, 0.1));
  p.position.set(0, 0, 0.22); e.add(p); pupils.push(p);
  const blush = new THREE.Mesh(new THREE.SphereGeometry(0.16, 12, 8), M(0xff4f8b, 0.8));
  blush.scale.set(1, 0.6, 0.3); blush.position.set(s*0.6, -0.4, 0.55); blush.rotation.y = s*0.6; eyes.add(blush);
});
const mouth = new THREE.Mesh(new THREE.SphereGeometry(0.3, 20, 12), M(0x4a0f2e, 0.5));
mouth.position.set(0, 0.8, 0.9); mouth.scale.set(1, 0.4, 0.3); blob.add(mouth);
const tongue = new THREE.Mesh(new THREE.SphereGeometry(0.14, 12, 8), M(0xff9ab0, 0.5));
tongue.position.set(0, -0.08, 0.1); tongue.scale.set(1, 0.7, 0.6); mouth.add(tongue);

const arms = [-1, 1].map(s => {
  const a = new THREE.Mesh(new THREE.SphereGeometry(0.24, 16, 12), M(0xff5fa5, 0.3));
  a.position.set(s*1.05, 1, 0); blob.add(a); return a;
});
const feet = [-1, 1].map(s => {
  const f = new THREE.Mesh(new THREE.SphereGeometry(0.3, 16, 12), M(0xff5fa5, 0.3));
  f.scale.set(1, 0.5, 1.3); f.position.set(s*0.45, 0.1, 0.35); blob.add(f); return f;
});

// ---- Clouds ----
const clouds = [];
for (let i = 0; i < 4; i++) {
  const c = new THREE.Group();
  for (let j = 0; j < 4; j++) {
    const s = new THREE.Mesh(new THREE.SphereGeometry(0.5 + Math.random()*0.4, 14, 10),
      new THREE.MeshBasicMaterial({color:0xffffff, transparent:true, opacity:0.8}));
    s.position.set(j*0.7 - 1, Math.random()*0.3, 0); c.add(s);
  }
  c.position.set(-9 + i*6, 5 + Math.random()*2.5, -7 - Math.random()*3);
  c.userData.speed = 0.15 + Math.random()*0.2;
  scene.add(c); clouds.push(c);
}

// ---- Confetti ----
const confetti = [];
const cGeo = new THREE.BoxGeometry(0.14, 0.14, 0.02);
const cols = [0xff4f8b, 0xffd23f, 0x3fd0ff, 0x7bff7b, 0xb36bff, 0xffffff];
function burst(n = 45) {
  for (let i = 0; i < n; i++) {
    const m = new THREE.Mesh(cGeo, new THREE.MeshBasicMaterial({color: cols[i % cols.length], side: THREE.DoubleSide}));
    m.position.set(0, blobRoot.position.y + 2.2, 0);
    m.userData = {v: new THREE.Vector3((Math.random()-.5)*7, 4 + Math.random()*5, (Math.random()-.2)*5),
                  r: new THREE.Vector3(Math.random()*10, Math.random()*10, Math.random()*10), life: 2.2};
    scene.add(m); confetti.push(m);
  }
}

// ---- Interaction ----
const mouse = {x: 0, y: 0};
addEventListener('pointermove', e => {
  mouse.x = (e.clientX / innerWidth) * 2 - 1;
  mouse.y = -((e.clientY / innerHeight) * 2 - 1);
});
const lines = ["Boing!", "I'm 100% jelly 🍮", "No bones, no problem", "Do I have something on my face?",
  "Wheee!", "Poke me again, coward", "I'm not fat, I'm fluffy", "Stop staring 👀", "Dance break! 💃", "Ouch... jk, I love it"];
const bubble = document.getElementById('bubble');
let bubbleTimer;
let excite = 0, spin = 0, spinTarget = 0, phase = 0, talk = 0;
function poke() {
  excite = 1.6; spinTarget += Math.PI * 2; talk = 1.4; burst();
  bubble.textContent = lines[Math.floor(Math.random() * lines.length)];
  bubble.style.opacity = 1;
  clearTimeout(bubbleTimer);
  bubbleTimer = setTimeout(() => bubble.style.opacity = 0, 1800);
}
addEventListener('pointerdown', poke);

// ---- Loop ----
const clock = new THREE.Clock();
const v = new THREE.Vector3();
let blinkT = 2;
function tick() {
  const dt = Math.min(clock.getDelta(), 0.05), t = clock.elapsedTime;
  excite = Math.max(0, excite - dt); talk = Math.max(0, talk - dt);
  phase += dt * (3 + Math.min(excite, 1) * 3);

  const h = Math.abs(Math.sin(phase));
  const k = Math.pow(1 - h, 6);                    // squash near the ground
  blobRoot.position.y = h * (1.4 + excite * 0.8);
  blob.scale.set(1 + 0.22*k - 0.08*h, 1 - 0.32*k + 0.18*h, 1 + 0.22*k - 0.08*h);
  spin += (spinTarget - spin) * Math.min(1, dt * 6);
  blob.rotation.y = spin + mouse.x * 0.5 + Math.sin(t * 1.5) * 0.1;
  blob.rotation.z = Math.sin(phase) * 0.08;

  const s = 1 - h * 0.7;
  shadow.scale.set(1.1 * s + 0.3, 1.1 * s + 0.3, 1);
  shadow.material.opacity = 0.12 + 0.15 * (1 - h);

  arms.forEach((a, i) => {
    const d = i ? 1 : -1;
    a.position.y = 1 + Math.sin(phase * 2 + i * Math.PI) * 0.35 + (excite > 0 ? 0.5 : 0);
    a.position.x = d * (1.05 + 0.1 * Math.sin(phase * 2));
  });
  feet.forEach((f, i) => f.position.y = 0.1 + (i ? Math.max(0, Math.sin(phase)) : Math.max(0, -Math.sin(phase))) * 0.05);

  // eyes follow the pointer
  pupils.forEach(p => p.position.set(mouse.x * 0.09, mouse.y * 0.08, 0.22));
  blinkT -= dt;
  eyes.scale.y = blinkT < 0 ? 0.1 : 1;
  if (blinkT < -0.15) blinkT = 1.5 + Math.random() * 3;

  // talking mouth + tongue
  mouth.scale.y = 0.4 + (talk > 0 ? Math.abs(Math.sin(t * 18)) * 0.5 : 0.1 * Math.sin(t * 3) + 0.1);
  tongue.visible = talk > 0 || h > 0.8;

  // speech bubble follows head
  v.set(0, blobRoot.position.y + 2.5, 0).project(camera);
  bubble.style.left = ((v.x + 1) / 2 * innerWidth) + 'px';
  bubble.style.top = ((1 - v.y) / 2 * innerHeight) + 'px';

  clouds.forEach(c => { c.position.x += c.userData.speed * dt; if (c.position.x > 12) c.position.x = -12; });

  for (let i = confetti.length - 1; i >= 0; i--) {
    const m = confetti[i], d = m.userData;
    d.v.y -= 9 * dt; m.position.addScaledVector(d.v, dt);
    m.rotation.x += d.r.x * dt; m.rotation.y += d.r.y * dt; m.rotation.z += d.r.z * dt;
    if (m.position.y < 0.05) { m.position.y = 0.05; d.v.set(0, 0, 0); d.r.multiplyScalar(0.9); }
    d.life -= dt; if (d.life < 0.5) m.scale.setScalar(Math.max(d.life * 2, 0.001));
    if (d.life <= 0) { scene.remove(m); m.material.dispose(); confetti.splice(i, 1); }
  }

  renderer.render(scene, camera);
  requestAnimationFrame(tick);
}
tick();
setTimeout(poke, 800);
</script>
</body>
</html>
